{
  "name": "card-defense",
  "version": "0.1.50",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "electron": "npm run build && npx electron .",
    "pack": "npm run build && npx electron-builder --dir",
    "dist": "npm run build && npx electron-builder"
  },
  "dependencies": {
    "phaser": "^3.60.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.carddefense.app",
    "productName": "PokerStrike",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "portable"
    },
    "portable": {
      "artifactName": "PokerStrike_v${version}_portable.exe"
    }
  }
}
