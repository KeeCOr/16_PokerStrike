{
    "name": "card-defense",
    "version": "0.4.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "electron": "npm run build && npx electron .",
        "pack": "npm run build && npx electron-builder --dir",
        "dist": "npm run build && npx electron-builder",
        "build:steam": "npm run build && npx electron-builder --win portable --config.win.signAndEditExecutable=false",
        "dist:steam": "npm run build && npx electron-builder --win portable --config.win.signAndEditExecutable=false"
    },
    "optionalDependencies": {
        "steamworks.js": "^0.3.1"
    },
    "dependencies": {
        "phaser": "^3.60.0"
    },
    "devDependencies": {
        "vite": "^5.0.0",
        "vitest": "^1.6.0",
        "electron": "^35.0.0",
        "electron-builder": "^25.0.0"
    },
    "build": {
        "appId": "com.carddefense.app",
        "productName": "PokerStrike",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/main.cjs",
            "electron/preload.cjs",
            "steam_appid.txt"
        ],
        "win": {
            "icon": "icon.ico",
            "target": "portable",
            "signAndEditExecutable": false
        },
        "portable": {
            "artifactName": "PokerStrike_v${version}_portable.exe"
        }
    }
}
